* { box-sizing: border-box; }
body { margin: 0; background-color: #1f232b; }
.App { text-align: center; font-family: 'Segoe UI', sans-serif; background-color: #1f232b; min-height: 100vh; color: white; }
.App-header { padding: 24px 5vw 48px; display: flex; flex-direction: column; align-items: center; }
.App-header h1 { font-size: 2rem; margin: 0 0 24px; }
.card { background: #2d323d; padding: 2rem; border-radius: 14px; box-shadow: 0 6px 24px rgba(0,0,0,0.35); width: 100%; max-width: 420px; }
.card:has(.grid), .card:has(table) { max-width: 1200px; }
input { display: block; width: 100%; max-width: 420px; margin: 10px auto; padding: 11px 12px; border-radius: 8px; border: 1px solid #4b5162; background: #fff; font-size: 0.95rem; }
button { background: #61dafb; color: #111; border: none; padding: 10px 20px; font-weight: bold; cursor: pointer; border-radius: 8px; margin: 10px 4px 0; transition: transform .1s, background .2s; }
button:hover { background: #8be6ff; transform: translateY(-1px); }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 18px; margin-top: 24px; }
.product-card { background: #3b4150; padding: 14px; border-radius: 12px; text-align: left; display: flex; flex-direction: column; gap: 4px; transition: transform .15s, box-shadow .15s; }
.product-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,0.35); }
.product-card h3 { margin: 6px 0 2px; }
.product-card p { margin: 4px 0; }
.product-card img { width: 100%; height: 180px; object-fit: cover; border-radius: 8px; }
.product-card button { margin-top: auto; align-self: flex-start; }
.price { color: #61dafb; font-weight: bold; font-size: 1.1rem; }
.small { font-size: 0.8rem; color: #aaa; }
table { width: 100%; border-collapse: collapse; margin: 16px 0; }
th, td { padding: 10px 12px; border-bottom: 1px solid #4b5162; text-align: left; }
th { background: #3b4150; }
@media (max-width: 600px) { .App-header h1 { font-size: 1.4rem; } .card { padding: 1.2rem; } }
